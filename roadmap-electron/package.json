{
  "name": "roadmap-builder-desktop",
  "version": "1.0.0",
  "description": "Roadmap Builder — desktop app for Windows",
  "author": "dnurullina001",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnurullina001/roadmap-builder.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist-portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.roadmapbuilder.app",
    "productName": "Roadmap Builder",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "!node_modules/**",
      "!dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "../artifacts/roadmap-builder/dist/public",
        "to": "app",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Roadmap Builder"
    },
    "portable": {
      "artifactName": "RoadmapBuilder-portable.exe"
    },
    "compression": "maximum",
    "asar": true
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
