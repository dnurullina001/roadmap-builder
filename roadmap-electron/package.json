{
  "name": "vektor-desktop",
  "version": "1.0.0",
  "description": "Вектор — инструмент для создания дорожных карт",
  "author": "dnurullina001",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnurullina001/roadmap-builder.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.vektor.roadmap",
    "productName": "Вектор",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/**",
      "app-dist/**"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip",  "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Вектор",
      "installerIcon": "build/icon.png"
    },
    "compression": "normal"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
